# Copy this to .env on the Docker VM before running docker compose
# Never commit .env to Git

# ── Shared credentials ────────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=changeme

# ── Elasticsearch ─────────────────────────────────────────────────────────
ELASTIC_PASSWORD=changeme
KIBANA_SYSTEM_PASSWORD=changeme
FLEET_SERVICE_TOKEN=
FLEET_SERVER_POLICY_ID=fleet-server-policy

# ── Domains (used by Traefik router rules) ────────────────────────────────
GITLAB_DOMAIN=gitlab.example.internal
GITLAB_REGISTRY_DOMAIN=registry.example.internal
SONARQUBE_DOMAIN=sonarqube.example.internal
KIBANA_DOMAIN=kibana.example.internal
DOCKHAND_DOMAIN=dockhand.example.internal
