<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskDesk.Api</RootNamespace>
    <!-- Must be false: Microsoft.Data.SqlClient requires ICU globalization (throws NotSupportedException under invariant mode). ICU ships in aspnet:10.0. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI YAML snapshot served at /api/docs.yaml (live JSON is at /openapi/v1.json). -->
    <Content Include="openapi.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB providers — selected at runtime via DB_PROVIDER (sqlite default; sqlserver for the compose stack). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Built-in OpenAPI document (serves /openapi/v1.json) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
  </ItemGroup>

</Project>
