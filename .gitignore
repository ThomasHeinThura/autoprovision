# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
coverage/

# The console build output is COMMITTED on purpose: the jump host has no Node and
# no registry access, so app/dist/ must ship in the repository.
console/dist/
!app/dist/

# Runtime state on the jump host (inventories with credentials, logs, kubeconfigs, staged PEMs)
data/
*.log
*.env
*.bak
*.tmp

# TLS material — NEVER commit private keys. Generated locally:
#   WSO2 certs:    WSO2_APIM_KUBE_ISTIO/scripts/generate-local-certificates.sh
#   Traefik cert:  generated by ansible/traefik_stack.yml on first deploy (or push via the UI)
*.key
*.csr
*.srl
WSO2_APIM_KUBE_ISTIO/certificates/
docker/traefik/certs/

# Vendored reference repos (not part of this project)
sql-docs*
reference/

credential*
# TypeScript build cache
*.tsbuildinfo

# Local incident/runbook writeups — internal topology, IPs, outage timelines.
# Never belongs in this public repo.
issues-tracker/
